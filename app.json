{
  "expo": {
    "name": "kura",
    "slug": "kura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kura-logo.png",
    "scheme": "kura",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.fmatangira.kura",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/kura-logo.png",
        "backgroundImage": "./assets/images/kura-logo.png",
        "monochromeImage": "./assets/images/kura-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fmatangira.kura"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kura-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/kura-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "kura-zm"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": { "root": "app" },
      "eas": {
        "projectId": "9221ff6a-e211-4b47-a6d6-5c7802d27239"
      }
    }
  }
}
